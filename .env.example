# Offline by default. Change to openai or anthropic for live research.
RA_LLM_PROVIDER=mock
RA_OPENAI_API_KEY=
RA_ANTHROPIC_API_KEY=
RA_TAVILY_API_KEY=
RA_OPENAI_MODEL=gpt-4o-mini
RA_OPENAI_JUDGE_MODEL=gpt-4o-mini
RA_ANTHROPIC_MODEL=claude-sonnet-4-5
RA_ANTHROPIC_JUDGE_MODEL=claude-haiku-4-5
RA_JUDGE_ENABLED=true
RA_MAX_TOOL_CALLS=16
RA_MAX_PAGES=6
RA_MAX_TOTAL_TOKENS=32000
RA_MAX_WALL_SECONDS=90
RA_TOOL_TIMEOUT_SECONDS=12
RA_LLM_TIMEOUT_SECONDS=25
RA_RETRIES=2
RA_CONCURRENCY=4
RA_CACHE_TTL_SECONDS=3600
# Estimates only. Set rates for your selected model; unset means unknown, not free.
# RA_INPUT_USD_PER_MILLION=
# RA_OUTPUT_USD_PER_MILLION=
# RA_JUDGE_INPUT_USD_PER_MILLION=
# RA_JUDGE_OUTPUT_USD_PER_MILLION=
