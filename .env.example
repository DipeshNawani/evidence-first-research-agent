# Offline by default. Change to openai, anthropic, or nvidia for live research.
RA_LLM_PROVIDER=mock
RA_OPENAI_API_KEY=
RA_ANTHROPIC_API_KEY=
RA_NVIDIA_API_KEY=
RA_TAVILY_API_KEY=
RA_OPENAI_MODEL=gpt-4o-mini
RA_OPENAI_JUDGE_MODEL=gpt-4o-mini
RA_ANTHROPIC_MODEL=claude-sonnet-4-5
RA_ANTHROPIC_JUDGE_MODEL=claude-haiku-4-5
RA_NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
RA_NVIDIA_JUDGE_MODEL=nvidia/nemotron-3-ultra-550b-a55b
RA_JUDGE_ENABLED=true
RA_MAX_TOOL_CALLS=16
RA_MAX_PAGES=6
RA_MAX_SEARCH_QUERIES_PER_STEP=1
RA_SYNTHESIS_RESERVE_SECONDS=35
RA_MAX_TOTAL_TOKENS=32000
RA_MAX_WALL_SECONDS=90
RA_TOOL_TIMEOUT_SECONDS=12
RA_LLM_TIMEOUT_SECONDS=25
# For NVIDIA's shared prototype endpoint, consider 60s per LLM call and 180s total.
RA_RETRIES=2
RA_CONCURRENCY=4
RA_CACHE_TTL_SECONDS=3600
RA_BRIEF_MAX_PAGES=2
RA_BRIEF_MAX_EVIDENCE=3
# Homepage export cache: cleared on restart; download results before stopping.
RA_RESULT_TTL_SECONDS=3600
RA_MAX_SAVED_RESULTS=64
RA_JUDGE_OUTPUT_TOKENS=600
# Estimates only. Set rates for your selected model; unset means unknown, not free.
# RA_INPUT_USD_PER_MILLION=
# RA_OUTPUT_USD_PER_MILLION=
# RA_JUDGE_INPUT_USD_PER_MILLION=
# RA_JUDGE_OUTPUT_USD_PER_MILLION=
